{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://deprail.dev/schemas/history-v1/history.schema.json",
  "title":"DepRail safe history projection v1","type":"object","additionalProperties":false,
  "required":["schema_version","history_entry_id","recorded_at_us","operation_outcome","repository_label","workspaces","report","diagnostics"],
  "properties":{
    "schema_version":{"const":"history-v1"},"history_entry_id":{"$ref":"#/$defs/uuid"},"recorded_at_us":{"type":"integer","minimum":0,"maximum":253402300799999999},"operation_outcome":{"enum":["completed","failed","cancelled"]},
    "repository_label":{"type":["string","null"],"minLength":1,"maxLength":256},"workspaces":{"type":["array","null"],"maxItems":1000,"items":{"$ref":"#/$defs/workspace"}},
    "report":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/report"}]},"diagnostics":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/diagnostic"}}
  },
  "$defs":{
    "uuid":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?![\\s\\S]*[\\u0000-\\u001f])(?:\\.|(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*)$"},
    "workspace":{"type":"object","additionalProperties":false,"required":["workspace_id","path","ecosystem","package_manager","discovery_completeness"],"properties":{"workspace_id":{"type":"string","minLength":1,"maxLength":256},"path":{"$ref":"#/$defs/path"},"ecosystem":{"enum":["npm","pnpm","yarn","python","maven","gradle","unknown"]},"package_manager":{"type":"string","minLength":1,"maxLength":128},"discovery_completeness":{"enum":["complete","partial","failed"]}}},
    "report":{"type":"object","additionalProperties":false,"required":["source_schema_version","source_scan_id","status","repository_state","provenance","findings","artifact_digests"],"properties":{"source_schema_version":{"const":"v1alpha"},"source_scan_id":{"type":"string","minLength":1,"maxLength":128},"status":{"enum":["complete","partial","failed"]},"repository_state":{"type":"string","pattern":"^[a-f0-9]{64}$"},"provenance":{"$ref":"#/$defs/provenance"},"findings":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/finding"}},"artifact_digests":{"type":"array","maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["deprail_version","scanner_name","scanner_version","scanner_database_version"],"properties":{"deprail_version":{"type":["string","null"],"minLength":1,"maxLength":128},"scanner_name":{"type":["string","null"],"minLength":1,"maxLength":128},"scanner_version":{"type":["string","null"],"minLength":1,"maxLength":128},"scanner_database_version":{"type":["string","null"],"minLength":1,"maxLength":128}}},
    "finding":{"type":"object","additionalProperties":false,"required":["stable_finding_key","component_name","component_purl","version","workspace_id","relative_path","ecosystem","vulnerability_id","aliases","severity","fixed_version"],"properties":{"stable_finding_key":{"type":"string","pattern":"^[a-f0-9]{64}$"},"component_name":{"type":"string","minLength":1,"maxLength":256},"component_purl":{"type":["string","null"],"minLength":1,"maxLength":2048,"pattern":"^pkg:"},"version":{"type":"string","minLength":1,"maxLength":128},"workspace_id":{"type":"string","minLength":1,"maxLength":256},"relative_path":{"$ref":"#/$defs/path"},"ecosystem":{"enum":["npm","pnpm","yarn","python","maven","gradle","unknown"]},"vulnerability_id":{"type":"string","minLength":1,"maxLength":256},"aliases":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},"severity":{"type":["string","null"],"enum":["unknown","low","moderate","high","critical",null]},"fixed_version":{"type":["string","null"],"minLength":1,"maxLength":128}}},
    "diagnostic":{"type":"object","additionalProperties":false,"required":["code","scope","message","workspace_id"],"properties":{"code":{"enum":["DISCOVERY_FAILED","DISCOVERY_INCOMPLETE","MANIFEST_INVALID","WALK_ENTRY_FAILED","PATH_OUTSIDE_ROOT","SYMLINK_SKIPPED","CONFIG_INVALID","SCANNER_VERSION_UNSUPPORTED","SCANNER_NOT_FOUND","SCANNER_EXIT_NONZERO","SCANNER_TIMEOUT","SCANNER_OUTPUT_LIMIT","SCANNER_OUTPUT_INVALID","ARTIFACT_STORE_FAILED","FINDING_NORMALIZATION_FAILED","COMPONENT_IDENTITY_INVALID","CANCELLED"]},"scope":{"enum":["repository","workspace"]},"workspace_id":{"type":["string","null"],"minLength":1,"maxLength":256},"message":{"type":"string","enum":["Workspace discovery failed.","Workspace discovery is incomplete.","A workspace manifest is invalid.","A repository entry could not be inspected.","A path resolves outside the repository.","A symlink was not traversed.","The scan configuration is invalid.","The scanner version is unsupported.","The scanner executable is unavailable.","The scanner exited unsuccessfully.","The scanner timed out.","Scanner output exceeded its limit.","Scanner output is invalid.","Scanner evidence could not be stored.","Findings could not be normalized.","A finding lacked safe component identity.","The scan operation was cancelled."]}},"allOf":[{"if":{"properties":{"scope":{"const":"workspace"}}},"then":{"properties":{"workspace_id":{"type":"string"}}}},{"if":{"properties":{"scope":{"const":"repository"}}},"then":{"properties":{"workspace_id":{"type":"null"}}}}],"oneOf":[{"properties":{"code":{"const":"DISCOVERY_FAILED"},"message":{"const":"Workspace discovery failed."}}},{"properties":{"code":{"const":"DISCOVERY_INCOMPLETE"},"message":{"const":"Workspace discovery is incomplete."}}},{"properties":{"code":{"const":"MANIFEST_INVALID"},"message":{"const":"A workspace manifest is invalid."}}},{"properties":{"code":{"const":"WALK_ENTRY_FAILED"},"message":{"const":"A repository entry could not be inspected."}}},{"properties":{"code":{"const":"PATH_OUTSIDE_ROOT"},"message":{"const":"A path resolves outside the repository."}}},{"properties":{"code":{"const":"SYMLINK_SKIPPED"},"message":{"const":"A symlink was not traversed."}}},{"properties":{"code":{"const":"CONFIG_INVALID"},"message":{"const":"The scan configuration is invalid."}}},{"properties":{"code":{"const":"SCANNER_VERSION_UNSUPPORTED"},"message":{"const":"The scanner version is unsupported."}}},{"properties":{"code":{"const":"SCANNER_NOT_FOUND"},"message":{"const":"The scanner executable is unavailable."}}},{"properties":{"code":{"const":"SCANNER_EXIT_NONZERO"},"message":{"const":"The scanner exited unsuccessfully."}}},{"properties":{"code":{"const":"SCANNER_TIMEOUT"},"message":{"const":"The scanner timed out."}}},{"properties":{"code":{"const":"SCANNER_OUTPUT_LIMIT"},"message":{"const":"Scanner output exceeded its limit."}}},{"properties":{"code":{"const":"SCANNER_OUTPUT_INVALID"},"message":{"const":"Scanner output is invalid."}}},{"properties":{"code":{"const":"ARTIFACT_STORE_FAILED"},"message":{"const":"Scanner evidence could not be stored."}}},{"properties":{"code":{"const":"FINDING_NORMALIZATION_FAILED"},"message":{"const":"Findings could not be normalized."}}},{"properties":{"code":{"const":"COMPONENT_IDENTITY_INVALID"},"message":{"const":"A finding lacked safe component identity."}}},{"properties":{"code":{"const":"CANCELLED"},"message":{"const":"The scan operation was cancelled."}}}]}
  }
}
