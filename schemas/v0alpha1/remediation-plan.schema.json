{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deprail.dev/schemas/v0alpha1/remediation-plan.schema.json",
  "title": "DepRail v0alpha1 remediation plan",
  "description": "Versioned, deterministic, read-only dependency remediation plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "created_from", "repository_identity",
    "workspace_identity", "finding_identity", "component", "current_state",
    "candidates", "recommendation", "affected_files", "commands", "risks",
    "assumptions", "verification", "rollback", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "v0alpha1" },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_from": { "$ref": "#/$defs/created_from" },
    "repository_identity": { "$ref": "#/$defs/repository_identity" },
    "workspace_identity": { "$ref": "#/$defs/workspace_identity" },
    "finding_identity": { "$ref": "#/$defs/finding_identity" },
    "component": { "$ref": "#/$defs/component" },
    "current_state": { "$ref": "#/$defs/current_state" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "recommendation": { "anyOf": [{ "$ref": "#/$defs/recommendation" }, { "type": "null" }] },
    "affected_files": { "type": "array", "items": { "$ref": "#/$defs/affected_file" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "rollback": { "$ref": "#/$defs/rollback" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1 },
    "relative_path": {
      "anyOf": [
        { "const": "." },
        {
          "allOf": [
            { "type": "string", "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$" },
            { "not": { "pattern": "\\.\\." } },
            { "not": { "pattern": "^\\./" } },
            { "not": { "pattern": "/\\./" } },
            { "not": { "pattern": "/\\.$" } }
          ]
        }
      ]
    },
    "created_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_digest", "source_scan_id", "scanner", "repository_state"],
      "properties": {
        "report_digest": { "$ref": "#/$defs/non_empty" },
        "source_scan_id": { "$ref": "#/$defs/non_empty" },
        "scanner": { "$ref": "#/$defs/non_empty" },
        "scanner_version": { "type": "string" },
        "repository_state": { "$ref": "#/$defs/non_empty" }
      }
    },
    "repository_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "repository"],
      "properties": {
        "root": { "$ref": "#/$defs/non_empty" },
        "repository": { "$ref": "#/$defs/non_empty" },
        "revision": { "type": "string" }
      }
    },
    "workspace_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty" },
        "path": { "$ref": "#/$defs/relative_path" }
      }
    },
    "finding_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_key", "current_version"],
      "properties": {
        "stable_key": { "$ref": "#/$defs/non_empty" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } },
        "dependency_path": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } },
        "current_version": { "$ref": "#/$defs/non_empty" },
        "fixed_versions": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purl", "name", "version"],
      "properties": {
        "purl": { "$ref": "#/$defs/non_empty" },
        "name": { "$ref": "#/$defs/non_empty" },
        "version": { "$ref": "#/$defs/non_empty" }
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "vulnerable"],
      "properties": {
        "direct": { "type": "boolean" },
        "constraint": { "type": "string" },
        "lockfile": { "type": "string" },
        "manifest": { "type": "string" },
        "vulnerable": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "state", "evidence", "direct", "major_change"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty" },
        "version": { "$ref": "#/$defs/non_empty" },
        "state": { "enum": ["recommended", "viable", "rejected", "unavailable", "unknown"] },
        "evidence": { "$ref": "#/$defs/compatibility_evidence" },
        "direct": { "type": "boolean" },
        "major_change": { "type": "boolean" },
        "rejection_code": { "type": "string" },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "recommended" } } },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "constraint_satisfied": { "const": true },
                  "lockfile_resolution": { "const": true },
                  "peer_compatible": { "const": true },
                  "runtime_compatible": { "const": true },
                  "engine_compatible": { "const": true },
                  "unknown": { "maxItems": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "compatibility_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_satisfied", "lockfile_resolution", "peer_compatible", "runtime_compatible", "engine_compatible"],
      "properties": {
        "constraint_satisfied": { "type": "boolean" },
        "lockfile_resolution": { "type": "boolean" },
        "peer_compatible": { "type": "boolean" },
        "runtime_compatible": { "type": "boolean" },
        "engine_compatible": { "type": "boolean" },
        "unknown": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "state"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/non_empty" },
        "state": { "const": "recommended" },
        "reason": { "type": "string" }
      }
    },
    "affected_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "kind": { "$ref": "#/$defs/non_empty" },
        "effect": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory"],
      "properties": {
        "executable": { "$ref": "#/$defs/non_empty" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "$ref": "#/$defs/relative_path" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "detected"],
      "properties": {
        "code": { "$ref": "#/$defs/non_empty" },
        "severity": { "$ref": "#/$defs/non_empty" },
        "detected": { "type": "boolean" },
        "details": { "type": "string" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/non_empty" },
        "details": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty" },
        "command": { "$ref": "#/$defs/command" },
        "reason": { "type": "string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "limits": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_digests", "sources"],
      "properties": {
        "artifact_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } }
      }
    }
  }
}
