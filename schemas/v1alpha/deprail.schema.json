{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deprail.dev/schemas/v1alpha/deprail.schema.json",
  "title": "DepRail v1alpha document",
  "description": "Versioned, provenance-preserving DepRail project and scan contracts.",
  "type": "object",
  "required": ["schema_version", "document_type"],
  "properties": {
    "schema_version": { "const": "v1alpha" },
    "document_type": {
      "enum": ["project", "workspace", "scan", "baseline", "diff", "component", "vulnerability", "finding", "evidence", "diagnostic"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/workspace" },
    { "$ref": "#/$defs/scan" },
    { "$ref": "#/$defs/baseline" },
    { "$ref": "#/$defs/diff" },
    { "$ref": "#/$defs/component" },
    { "$ref": "#/$defs/vulnerability" },
    { "$ref": "#/$defs/finding" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^[^/].*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "completeness": { "enum": ["complete", "partial", "failed"] },
    "ecosystem": { "enum": ["npm", "pnpm", "yarn", "python", "maven", "gradle", "unknown"] },
    "severity": { "enum": ["unknown", "low", "moderate", "high", "critical"] },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "scope", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" },
        "help": { "type": "string" }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "required": ["schema_version", "document_type", "workspace_id", "relative_path", "ecosystem", "package_manager", "manifests", "lockfiles", "completeness"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "workspace" },
        "workspace_id": { "$ref": "#/$defs/id" },
        "relative_path": { "$ref": "#/$defs/path" },
        "ecosystem": { "$ref": "#/$defs/ecosystem" },
        "package_manager": { "type": "string", "minLength": 1 },
        "manifests": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "lockfiles": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "scope": { "type": "string" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["schema_version", "document_type", "repository_root", "display_name", "workspaces", "completeness", "diagnostics"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "project" },
        "repository_root": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "configuration_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "workspaces": { "type": "array", "items": { "$ref": "#/$defs/workspace" } },
        "completeness": { "$ref": "#/$defs/completeness" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "additionalProperties": true
    },
    "scan": {
      "type": "object",
      "required": ["schema_version", "document_type", "scan_id", "status", "findings", "errors"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "scan" },
        "scan_id": { "$ref": "#/$defs/id" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "tool": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "database": { "type": "string" } }, "additionalProperties": true },
        "plan": { "type": "object", "additionalProperties": true },
        "status": { "$ref": "#/$defs/completeness" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "artifact_digests": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["schema_version", "document_type", "baseline_id", "source_scan_id", "status", "findings", "artifact_digests"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "baseline" },
        "baseline_id": { "$ref": "#/$defs/id" },
        "source_scan_id": { "$ref": "#/$defs/id" },
        "status": { "const": "complete" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stable_key", "component", "version"],
            "properties": {
              "stable_key": { "$ref": "#/$defs/id" },
              "workspace_id": { "$ref": "#/$defs/id" },
              "severity": { "enum": ["unknown", "low", "medium", "high", "critical"] },
              "version": { "$ref": "#/$defs/id" },
              "target_id": { "type": "string" },
              "vulnerability_aliases": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        },
        "artifact_digests": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["schema_version", "document_type", "base_scan_id", "head_scan_id", "base_artifact_digests", "head_artifact_digests", "changes"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "diff" },
        "base_scan_id": { "$ref": "#/$defs/id" },
        "head_scan_id": { "$ref": "#/$defs/id" },
        "base_artifact_digests": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
        "head_artifact_digests": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
        "changes": { "type": "array" }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["schema_version", "document_type", "name", "version", "ecosystem"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "component" },
        "purl": { "type": "string", "minLength": 1 },
        "ecosystem": { "$ref": "#/$defs/ecosystem" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "workspace_id": { "$ref": "#/$defs/id" },
        "direct": { "type": "boolean" },
        "dependency_paths": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      },
      "additionalProperties": true
    },
    "vulnerability": {
      "type": "object",
      "required": ["schema_version", "document_type", "canonical_id", "aliases", "sources"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "vulnerability" },
        "canonical_id": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "affected_ranges": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "severity_observations": { "type": "array", "items": { "type": "object", "required": ["source", "severity"], "properties": { "source": { "type": "string" }, "severity": { "$ref": "#/$defs/severity" }, "score": { "type": "number" } }, "additionalProperties": true } },
        "references": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
        "fixed_versions": { "type": "array", "items": { "type": "object", "required": ["version", "source"], "properties": { "version": { "type": "string" }, "source": { "type": "string" } }, "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["schema_version", "document_type", "adapter", "tool_version", "source_id", "workspace_id", "raw_artifact_digest"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "evidence" },
        "adapter": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "source_database": { "type": "string" },
        "source_id": { "type": "string", "minLength": 1 },
        "workspace_id": { "$ref": "#/$defs/id" },
        "dependency_path": { "type": "array", "items": { "type": "string" } },
        "raw_artifact_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_location": { "type": "string" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["schema_version", "document_type", "stable_key", "component", "vulnerability", "evidence", "state"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "finding" },
        "stable_key": { "type": "string", "minLength": 1 },
        "component": { "$ref": "#/$defs/component" },
        "vulnerability": { "$ref": "#/$defs/vulnerability" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "fixed_versions": { "type": "array", "items": { "type": "object", "required": ["version", "source"], "properties": { "version": { "type": "string" }, "source": { "type": "string" } }, "additionalProperties": true } },
        "state": { "enum": ["open", "resolved", "ignored", "unknown"] }
      },
      "additionalProperties": true
    },
    "diagnostic_document": {
      "type": "object",
      "required": ["schema_version", "document_type", "diagnostic"],
      "properties": {
        "schema_version": { "const": "v1alpha" },
        "document_type": { "const": "diagnostic" },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      },
      "additionalProperties": true
    }
  }
}
